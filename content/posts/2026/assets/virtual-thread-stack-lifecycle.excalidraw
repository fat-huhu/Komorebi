    {
      "type": "text",
      "id": "code_text",
      "x": 78,
      "y": 523,
      "width": 472,
      "height": 104,
      "text": "try (var ex = Executors.newVirtualThreadPerTaskExecutor()) {\n    ex.submit(() -> httpClient.send(req, handler));\n}\n// 阻塞等待时：VT 卸载，carrier 不陪等",
